rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'iqbal140605@gmail.com' ||
        request.auth.token.role == 'superadmin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'))
      );
    }

    // 1. Koleksi Pengguna (Users)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Koleksi Pelanggan (Customers)
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Koleksi Paket VPS (vps_packages)
    match /vps_packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Koleksi Layanan VPS (vps_services)
    match /vps_services/{serviceId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Koleksi Tagihan (Invoices)
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Koleksi Pembayaran (Payments)
    match /payments/{paymentId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 7. Koleksi Perpanjangan Layanan (service_renewals)
    match /service_renewals/{renewalId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Koleksi Log Aktivitas (activity_logs)
    match /activity_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 9. Koleksi Notifikasi (notifications)
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Koleksi Laporan & Dokumen Lainnya
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
